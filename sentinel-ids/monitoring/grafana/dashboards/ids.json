{
 "title": "IDS System Health & Threat Spikes",
 "uid": "ids-health",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Ingestion throughput (events/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(rate(ingest_events_total[1m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Threats/s by severity",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum by (severity)(rate(threats_total[1m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Threats/s by attack type",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "expr": "sum by (label)(rate(threats_total[1m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Inference p95 latency (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95,sum by (le)(rate(ml_inference_seconds_bucket[1m])))",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95,sum by (le)(rate(inference_roundtrip_seconds_bucket[1m])))",
     "refId": "B"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Prediction errors/s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "expr": "rate(prediction_errors_total[1m])",
     "refId": "A"
    },
    {
     "expr": "rate(ml_prediction_errors_total[1m])",
     "refId": "B"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Avg Kafka batch size (lag proxy)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "targets": [
    {
     "expr": "rate(kafka_batch_size_sum[1m])/rate(kafka_batch_size_count[1m])",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Gateway memory (bytes)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "expr": "process_resident_memory_bytes{job=\"gateway\"}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "API p95 latency (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95,sum by (le,route)(rate(http_request_duration_seconds_bucket[1m])))",
     "refId": "A"
    }
   ]
  }
 ]
}